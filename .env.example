# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT
JWT_SECRET="your-strong-random-secret-here"

# Storage immagini — Cloudflare R2 (S3-compatibile).
# Se NON impostate, gli upload finiscono su disco locale (non persistente su Railway!).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="prontopsicologo-uploads"
# URL pubblico del bucket: dominio r2.dev abilitato o dominio custom (senza slash finale)
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_ANNUAL="price_..."

# Frontend (usato per success/cancel URL Stripe) — senza slash finale
FRONTEND_URL="https://prontopsicologo-61658.web.app"

# Email (Resend)
RESEND_API_KEY="re_..."
# URL del backend (usato nei link delle email di verifica) — senza slash finale
BACKEND_URL="https://pronto-psicologo-backend-production.up.railway.app"

# Firebase Admin (JSON del service account, su una riga)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'

# AI matching (opzionale)
ANTHROPIC_API_KEY="sk-ant-..."
