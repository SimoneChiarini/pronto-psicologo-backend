generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String         @unique @db.VarChar(255)
  password                 String         @db.VarChar(255)
  role                     String         @db.VarChar(50)
  firstName                String?        @db.VarChar(100)
  lastName                 String?        @db.VarChar(100)
  profileImage             String?        @db.VarChar(500)
  latitude                 Float?
  longitude                Float?
  fcmToken                 String?        @db.VarChar(500)
  phone                    String?        @db.VarChar(20)
  phoneVerified            Boolean        @default(false)
  emailVerified            Boolean        @default(false)
  emailVerificationToken   String?        @db.VarChar(200)
  emailVerificationExpires DateTime?
  // Recupero password: si salva solo lo SHA-256 del token inviato via email
  passwordResetTokenHash   String?        @unique @db.VarChar(64)
  passwordResetExpires     DateTime?
  createdAt                DateTime?      @default(now()) @db.Timestamp(6)
  Conversation             Conversation[]
  psychologist             Psychologist?
  questions                Question[]
  Review                   Review[]
  sentMessages             Message[]
  appointments             Appointment[]
  reportsMade              Report[]       @relation("ReportReporter")
  reportsReceived          Report[]       @relation("ReportReported")

  @@index([role]) // lista utenti/admin per ruolo
  @@index([emailVerificationToken]) // verify-email
}

model Psychologist {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                       @unique @db.Uuid
  bio                  String?
  alboCode             String                       @unique @db.VarChar(100)
  verified             Boolean?                     @default(false)
  subscriptionActive   Boolean?                     @default(false)
  subscriptionPlan     String?                      @db.VarChar(20)
  contractAcceptedAt   DateTime?                    @db.Timestamp(6)
  contractVersion      String?                      @db.VarChar(20)
  stripeCustomerId     String?                      @db.VarChar(100)
  stripeSubscriptionId String?                      @db.VarChar(100)
  REM                  Boolean?                     @default(false)
  profileImage         String?                      @db.VarChar(500)
  phone                String?                      @db.VarChar(20)
  latitude             Float?
  longitude            Float?
  isOnlineOnly         Boolean?                     @default(false)
  isPsychotherapist    Boolean?                     @default(false)
  createdAt            DateTime?                    @default(now()) @db.Timestamp(6)
  isMale               Boolean?
  coverImage           String?                      @db.VarChar(500)
  alboVerified         Boolean?                     @default(false)
  alboVerifiedAt       DateTime?                    @db.Timestamp(6)
  alboOrdine           String?                      @db.VarChar(50)
  alboSezione          String?                      @db.VarChar(5)
  alboCheckResult      String?                      @db.VarChar(20)
  answers              Answer[]
  Conversation         Conversation[]
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Review               Review[]
  sentMessages         Message[]
  appointments         Appointment[]
  posts                Post[]
  addresses            PsychologistAddress[]
  specializations      PsychologistSpecialization[]
  // Area professionisti: intervisioni e supervisioni
  groupsCreated        PeerGroup[]                  @relation("PeerGroupCreator")
  groupMemberships     PeerGroupMember[]
  casesAuthored        CaseDiscussion[]
  caseMessages         CaseMessage[]
  meetingsCreated      GroupMeeting[]
  supervisorProfile    SupervisorProfile?
  supervisionsGiven    Supervision[]                @relation("SupervisionSupervisor")
  supervisionsCreated  Supervision[]                @relation("SupervisionCreator")
  supervisionSeats     SupervisionParticipant[]

  @@index([verified, subscriptionActive]) // lista pubblica psicologi
  @@index([stripeCustomerId]) // webhook Stripe
}

model PsychologistSpecialization {
  psychologistId String       @db.Uuid
  tagCode        String       @db.VarChar(100)
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([psychologistId, tagCode])
  @@index([tagCode])
}

model PsychologistAddress {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  psychologistId String       @db.Uuid
  address        String       @db.VarChar(500)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([psychologistId])
}

model Question {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @db.Uuid
  title        String         @db.VarChar(255)
  content      String
  isAnonymous  Boolean?       @default(false)
  createdAt    DateTime?      @default(now()) @db.Timestamp(6)
  answers      Answer[]
  Conversation Conversation[]
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([createdAt])
}

model Answer {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId     String         @db.Uuid
  psychologistId String         @db.Uuid
  content        String
  createdAt      DateTime?      @default(now()) @db.Timestamp(6)
  psychologist   Psychologist   @relation(fields: [psychologistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Conversation   Conversation[]

  @@index([questionId])
  @@index([psychologistId])
}

model Conversation {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @db.Uuid
  psychologistId  String       @db.Uuid
  firstQuestionId String       @db.Uuid
  firstAnswerId   String       @db.Uuid
  createdAt       DateTime?    @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?    @default(now()) @db.Timestamp(6)
  Answer          Answer       @relation(fields: [firstAnswerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Question        Question     @relation(fields: [firstQuestionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Psychologist    Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User            User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages        Message[]
  reports         Report[]

  @@index([userId, psychologistId])
  @@index([psychologistId])
  @@index([firstQuestionId])
  @@index([firstAnswerId])
  @@index([updatedAt])
}

model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @db.Uuid
  senderUserId   String?       @db.Uuid
  senderPsychId  String?       @db.Uuid
  content        String
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  senderUser     User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  senderPsych    Psychologist? @relation(fields: [senderPsychId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([senderPsychId])
}

model AppSettings {
  id              String   @id @default("singleton")
  radiusKm        Float    @default(50)
  expandMinutes   Int      @default(60)
  maxAnswers      Int      @default(5)
  // Max membri per gruppo di intervisione/supervisione (0 = nessun limite)
  maxGroupMembers Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Appointment {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  psychologistId     String       @db.Uuid
  userId             String?      @db.Uuid
  title              String       @db.VarChar(255)
  notes              String?
  startTime          DateTime     @db.Timestamp(6)
  endTime            DateTime     @db.Timestamp(6)
  isExternal         Boolean      @default(false)
  externalClientName String?      @db.VarChar(255)
  status             String       @default("CONFIRMED") @db.VarChar(50)
  createdAt          DateTime     @default(now()) @db.Timestamp(6)
  psychologist       Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([psychologistId, startTime])
  @@index([userId, startTime])
}

model Post {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  psychologistId String       @db.Uuid
  content        String
  imageUrl       String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamp(6)
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Review {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  psychologistId String       @db.Uuid
  rating         Int
  comment        String?
  createdAt      DateTime?    @default(now()) @db.Timestamp(6)
  Psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Una sola recensione per coppia utente/psicologo
  @@unique([userId, psychologistId])
  @@index([psychologistId])
}

// Segnalazione di uso scorretto fatta da una delle due parti di una conversazione.
// Il segnalato è sempre l'altra parte (ricavato dal backend, mai dal client).
model Report {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable + SetNull: la segnalazione sopravvive alla cancellazione dell'account
  // (altrimenti chi viene segnalato potrebbe cancellarsi per far sparire le tracce)
  reporterUserId String?       @db.Uuid
  reportedUserId String?       @db.Uuid
  reportedLabel  String?       @db.VarChar(255) // "Nome Cognome (ruolo)" al momento della segnalazione
  conversationId String?       @db.Uuid
  // In alternativa a conversationId: messaggio segnalato in un gruppo professionisti
  caseMessageId  String?       @db.Uuid
  reason         String        @db.VarChar(40)
  details        String?
  status         String        @default("OPEN") @db.VarChar(20) // OPEN | IN_REVIEW | RESOLVED | DISMISSED
  adminNote      String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  resolvedAt     DateTime?     @db.Timestamp(6)
  reporter       User?         @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reported       User?         @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  caseMessage    CaseMessage?  @relation(fields: [caseMessageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([caseMessageId])
  @@index([reportedUserId])
  @@index([reporterUserId, conversationId])
  @@index([conversationId])
}

// ─────────────────────────────────────────────────────────────
// AREA PROFESSIONISTI — intervisioni (tra pari) e supervisioni
// Accesso: solo psicologi verificati con abbonamento attivo.
// L'admin NON legge questi contenuti, salvo i messaggi segnalati.
// ─────────────────────────────────────────────────────────────

// Stanza di confronto. INTERVISION = gruppo tra pari; SUPERVISION = stanza
// privata creata all'accettazione di una Supervision.
model PeerGroup {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String    @default("INTERVISION") @db.VarChar(20) // INTERVISION | SUPERVISION
  name        String    @db.VarChar(120)
  description String?
  visibility  String    @default("PUBLIC") @db.VarChar(10) // PUBLIC (richiesta di ingresso) | PRIVATE (solo invito)
  topics      String[]  @default([]) // tagCode delle specializzazioni
  createdById String?   @db.Uuid
  archivedAt  DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  createdBy   Psychologist?     @relation("PeerGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     PeerGroupMember[]
  cases       CaseDiscussion[]
  meetings    GroupMeeting[]
  supervision Supervision?

  @@index([type, visibility, archivedAt])
  @@index([createdById])
}

model PeerGroupMember {
  groupId                   String    @db.Uuid
  psychologistId            String    @db.Uuid
  role                      String    @default("MEMBER") @db.VarChar(20) // OWNER | MODERATOR | MEMBER | SUPERVISOR
  status                    String    @default("ACTIVE") @db.VarChar(20) // REQUESTED | INVITED | ACTIVE
  confidentialityAcceptedAt DateTime? @db.Timestamp(6)
  joinedAt                  DateTime  @default(now()) @db.Timestamp(6)

  group        PeerGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([groupId, psychologistId])
  @@index([psychologistId, status])
}

// Un caso presentato al gruppo, con scheda guidata anonima.
model CaseDiscussion {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId                  String   @db.Uuid
  authorId                 String   @db.Uuid
  title                    String   @db.VarChar(160)
  ageRange                 String?  @db.VarChar(20) // es. "18-25"
  setting                  String?  @db.VarChar(30) // PRIVATE | PUBLIC_SERVICE | ONLINE | OTHER
  presentingProblem        String
  question                 String // la domanda precisa posta al gruppo
  status                   String   @default("OPEN") @db.VarChar(10) // OPEN | CLOSED
  anonymizationConfirmedAt DateTime @db.Timestamp(6)
  lastActivityAt           DateTime @default(now()) @db.Timestamp(6)
  createdAt                DateTime @default(now()) @db.Timestamp(6)

  group    PeerGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   Psychologist  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages CaseMessage[]

  @@index([groupId, lastActivityAt])
  @@index([authorId])
}

model CaseMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String    @db.Uuid
  authorId  String?   @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  case    CaseDiscussion @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author  Psychologist?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reports Report[]

  @@index([caseId, createdAt])
  @@index([authorId])
}

// Incontro in videochiamata esterna (Meet/Teams/Zoom): solo link condiviso.
model GroupMeeting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String   @db.Uuid
  createdById String?  @db.Uuid
  title       String   @db.VarChar(160)
  startsAt    DateTime @db.Timestamp(6)
  url         String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  group     PeerGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy Psychologist? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([groupId, startsAt])
}

// Lo psicologo sceglie da sé di offrire supervisione (nessuna approvazione admin).
model SupervisorProfile {
  psychologistId           String   @id @db.Uuid
  active                   Boolean  @default(true)
  bio                      String?
  orientation              String?  @db.VarChar(120)
  yearsExperience          Int?
  priceIndividualCents     Int // supervisione individuale, prezzo totale
  pricePerParticipantCents Int // supervisione di gruppo, prezzo per partecipante
  stripeAccountId          String?  @unique @db.VarChar(100) // Stripe Connect Express
  payoutsEnabled           Boolean  @default(false)
  createdAt                DateTime @default(now()) @db.Timestamp(6)
  updatedAt                DateTime @default(now()) @updatedAt @db.Timestamp(6)

  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([active])
}

// Richiesta di supervisione su un caso. All'accettazione si crea la stanza
// (PeerGroup type SUPERVISION); ogni partecipante entra dopo aver pagato.
model Supervision {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supervisorId String?   @db.Uuid
  createdById  String?   @db.Uuid
  mode         String    @db.VarChar(15) // INDIVIDUAL | GROUP
  title        String    @db.VarChar(160)
  caseSummary  String // sintesi anonima del caso
  status       String    @default("REQUESTED") @db.VarChar(15) // REQUESTED | ACCEPTED | DECLINED | COMPLETED | CANCELLED
  priceCents   Int // prezzo per partecipante, fissato alla richiesta
  feePercent   Int       @default(10) // commissione piattaforma fissata alla richiesta
  groupId      String?   @unique @db.Uuid
  respondedAt  DateTime? @db.Timestamp(6)
  completedAt  DateTime? @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)

  supervisor   Psychologist?            @relation("SupervisionSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  createdBy    Psychologist?            @relation("SupervisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  group        PeerGroup?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  participants SupervisionParticipant[]

  @@index([supervisorId, status])
  @@index([createdById])
}

model SupervisionParticipant {
  supervisionId           String    @db.Uuid
  psychologistId          String    @db.Uuid
  status                  String    @default("INVITED") @db.VarChar(15) // INVITED | CONFIRMED | DECLINED
  paymentStatus           String    @default("UNPAID") @db.VarChar(15) // UNPAID | PENDING | PAID | REFUNDED
  stripeCheckoutSessionId String?   @unique @db.VarChar(100)
  stripePaymentIntentId   String?   @db.VarChar(100)
  amountCents             Int?
  feeCents                Int?
  paidAt                  DateTime? @db.Timestamp(6)

  supervision  Supervision  @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([supervisionId, psychologistId])
  @@index([psychologistId])
}
